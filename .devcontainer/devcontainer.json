{
  "name": "tapp",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "postCreateCommand": "npm install",
  "forwardPorts": [8081],
  "portsAttributes": {
    "8081": {
      "label": "Expo Dev Server",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["expo.vscode-expo-tools", "dbaeumer.vscode-eslint"]
    }
  }
}
